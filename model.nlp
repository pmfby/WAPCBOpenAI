  "nlgManager": {
    "settings": {
      "tag": "nlg-manager"
    },
    "responses": {
      "en": {
        "pmfby.objective": [
          {
            "answer": "Pradhan Mantri Fasal Bima Yojana (PMFBY) is a Government Scheme that aims at providing crop insurance protection to farmers, when notified crops are damaged due to unexpected natural calamities like hailstorm, drought, floods, cyclones, heavy and unseasonal rains, attack of disease and pests etc."
          }
        ],
        "pmfby.info": [
          {
            "answer": "Pradhan Mantri Fasal Bima Yojana (PMFBY) is a Government Scheme that aims at providing crop insurance protection to farmers, when notified crops are damaged due to unexpected natural calamities like hailstorm, drought, floods, cyclones, heavy and unseasonal rains, attack of disease and pests etc."
          }
        ],
        "pmfby.launchDate": [
          {
            "answer": "The PMFBY scheme was launched on 18th February 2016, by the honorable Prime Minister of India."
          }
        ],
        "pmfby.revampDate": [
          {
            "answer": "The revamped guidelines came into effect from Kharif 2023."
          }
        ],
        "pmfby.risks": [
          {
            "answer": "PMFBY covers risks such as drought, flood, cyclone, hailstorm, pest attacks, and diseases from the sowing to post-harvest stage."
          }
        ],
        "pmfby.eligibility": [
          {
            "answer": "All farmers, including tenant farmers and sharecroppers cultivating notified crops in notified areas, are eligible for PMFBY."
          }
        ],
        "pmfby.exclusions": [
          {
            "answer": "PMFBY does not cover losses arising from war, nuclear risks, malicious damage, or preventable risks."
          }
        ],
        "pmfby.premium": [
          {
            "answer": "Farmers pay 2% of the sum insured for Kharif crops, 1.5% for Rabi crops, and 5% for commercial or horticultural crops. The balance premium is shared by the government."
          }
        ],
        "pmfby.fileClaim": [
          {
            "answer": "Farmers can file claims by reporting crop loss to their insurance company, local agriculture department, or CSC within 72 hours of the event."
          }
        ],
        "pmfby.grievance": [
          {
            "answer": "Farmers can register grievances through the Krishi Rakshak Portal, helplines, or designated offices. The scheme has a structured grievance redressal mechanism at the district, state, and national levels."
          }
        ],
        "pmfby.wildAnimals": [
          {
            "answer": "PMFBY offers add-on coverage for crop loss due to wild animal attacks, but the premium for this is fully borne by the farmer unless subsidized by the state government."
          }
        ],
        "pmfby.sumInsured": [
          {
            "answer": "The sum insured is calculated based on the cost of cultivation, including expenses such as seeds, fertilizers, pesticides, labor, and other inputs. It is determined by the State Level Coordination Committee on Crop Insurance (SLCCCI)."
          }
        ],
        "pmfby.technology": [
          {
            "answer": "PMFBY uses technology such as satellite imagery, drones, and mobile apps for monitoring crops, assessing losses, and ensuring transparency in implementation."
          }
        ],
        "pmfby.enrollment": [
          {
            "answer": "Farmers can enroll in PMFBY through banks, CSCs, or the National Crop Insurance Portal (NCIP) before the cut-off date for each season."
          }
        ],
        "pmfby.claimSettlement": [
          {
            "answer": "Claims under PMFBY are processed based on yield data and crop loss reports submitted by the state government. Payments are made directly to the farmer’s bank account."
          }
        ],
        "pmfby.midSeason": [
          {
            "answer": "Mid-season adversity refers to crop losses caused by extreme weather conditions like drought or flood after sowing but before the crop matures. Farmers can report such adversities to the insurance company or local authorities. Compensation is based on crop damage assessment and is disbursed accordingly."
          }
        ],
        "pmfby.midSeasonPercentage": [
          {
            "answer": "Under PMFBY, up to 25% of the sum insured is paid as compensation for mid-season adversity to provide immediate relief to farmers."
          }
        ],
        "pmfby.subsidy": [
          {
            "answer": "The premium is subsidized by the Central and State Governments to make it affordable for farmers."
          }
        ],
        "pmfby.postHarvest": [
          {
            "answer": "Post-harvest coverage under PMFBY protects farmers from crop losses caused by natural calamities like cyclones, unseasonal rains, and hailstorms during the harvesting period. Farmers must report losses within 72 hours to claim compensation."
          }
        ],
        "pmfby.postHarvestPercentage": [
          {
            "answer": "Under PMFBY, the entire sum insured is payable for post-harvest losses, subject to the terms and conditions of the scheme."
          }
        ],
        "pmfby.coverageCrops": [
          {
            "answer": "PMFBY covers all food crops (cereals, pulses, and oilseeds), commercial crops (cotton, sugarcane, etc.), and horticultural crops as per state government notification."
          }
        ],
        "pmfby.seasonality": [
          {
            "answer": "Seasonality discipline under PMFBY ensures adherence to prescribed timelines for premium payments, enrollment, and claim settlements based on crop seasons."
          }
        ],
        "pmfby.importantClauses": [
          {
            "answer": "Important conditions include mandatory coverage for loanee farmers, adherence to cut-off dates, timely premium payment, and compliance with yield estimation procedures."
          }
        ],
        "pmfby.claimMultipleEvents": [
          {
            "answer": "Claims under multiple events are assessed based on the maximum loss percentage, ensuring that total claims do not exceed the sum insured for the season."
          }
        ],
        "pmfby.serviceCharges": [
          {
            "answer": "No service charges are applicable for farmers. However, intermediaries like banks or CSCs may charge nominal service fees for enrollment processing."
          }
        ],
        "pmfby.gst": [
          {
            "answer": "No, GST is exempted on the premium paid under PMFBY to ensure affordability for farmers."
          }
        ],
        "pmfby.lossAssessment": [
          {
            "answer": "Loss assessment is based on Crop Cutting Experiments (CCEs) conducted by state authorities using a statistically designed methodology."
          }
        ],
        "pmfby.rwbcis": [
          {
            "answer": "RWBCIS stands for Restructured Weather Based Crop Insurance Scheme, which provides insurance against adverse weather conditions like drought, excessive rainfall, frost, humidity, and temperature fluctuations affecting crops."
          }
        ],
        "pmfby.rwbcis.difference": [
          {
            "answer": "PMFBY covers yield losses due to various calamities, whereas RWBCIS insures farmers against weather-related risks that directly affect crop growth and yield."
          }
        ],
        "pmfby.rwbcis.eligibility": [
          {
            "answer": "All farmers, including loanee and non-loanee farmers, growing notified crops in notified areas, are eligible for RWBCIS."
          }
        ],
        "pmfby.claim": [
          {
            "answer": "Farmers must notify the insurance company or local agriculture officer within 72 hours of crop loss. Claims are processed based on yield data submitted via NCIP."
          }
        ],
        "pmfby.claim.status": [
          {
            "answer": "Farmers can check their claim status through the NCIP website (www.pmfby.gov.in), their insurance company’s portal, Common Service Centers (CSCs), or local agriculture offices."
          }
        ],
        "None": [
          {
            "answer": "I can only assist with PMFBY Scheme & crop insurance-related inquiries. Please ask questions specific to these topics."
          }
        ],
        "pmfby.infoSource": [
          {
            "answer": "For more details, visit the official PMFBY website (www.pmfby.gov.in) or contact your local agricultural office."
          }
        ],
        "pmfby.ncip": [
          {
            "answer": "NCIP is a digital platform for real-time scheme administration, farmer enrollment, and claim processing."
          }
        ],
        "pmfby.yestech": [
          {
            "answer": "YES-TECH (Yield Estimation System Based on Technology) is an AI-based direct yield estimation method using drones, satellite imagery, and remote sensing."
          }
        ],
        "pmfby.sarthi": [
          {
            "answer": "SARTHI (Sandbox for Agricultural & Rural Security, Technology & Insurance) is an open-source digital platform aimed at expanding rural insurance coverage."
          }
        ],
        "pmfby.rwbcis.claims": [
          {
            "answer": "Claims under RWBCIS are based on weather data recorded by Automatic Weather Stations (AWS) or government-approved meteorological agencies. If predefined weather thresholds are exceeded, the insurance payout is triggered automatically."
          }
        ],
        "pmfby.farmer.apply": [
          {
            "answer": "Small farmers can apply for PMFBY through banks, Common Service Centers (CSCs), insurance company representatives, or directly via the National Crop Insurance Portal (NCIP)."
          }
        ],
        "pmfby.farmer.tenant": [
          {
            "answer": "Yes, tenant farmers and sharecroppers are eligible for PMFBY if they cultivate notified crops in notified areas. They must provide land lease agreements or farmer certificates to enroll."
          }
        ],
        "pmfby.farmer.compensation": [
          {
            "answer": "The compensation amount depends on the sum insured, which is calculated based on the cost of cultivation. The claim is processed based on crop cutting experiments and remote sensing assessments."
          }
        ],
        "pmfby.farmer.deadline": [
          {
            "answer": "The deadline to enroll for PMFBY varies by state and crop season. Farmers should check with their local agriculture office or visit www.pmfby.gov.in for updated timelines."
          }
        ],
        "pmfby.farmer.claim.status": [
          {
            "answer": "Farmers can check their claim status by visiting the National Crop Insurance Portal (NCIP), contacting their insurance company, or visiting a nearby Common Service Center (CSC)."
          }
        ],
        "pmfby.farmer.documents": [
          {
            "answer": "Farmers need to provide an Aadhaar card, land records, sowing certificates, bank account details, and crop loss evidence for claim processing."
          }
        ],
        "pmfby.farmer.kcc": [
          {
            "answer": "Yes, for loanee farmers, PMFBY premiums are automatically deducted from their Kisan Credit Card (KCC) loan accounts unless they opt out within the given time frame."
          }
        ],
        "pmfby.farmer.missedDeadline": [
          {
            "answer": "If you miss the PMFBY enrollment deadline, you will not be eligible for coverage for that season. You must wait for the next crop season to apply again."
          }
        ],
        "pmfby.farmer.complaint": [
          {
            "answer": "Yes, if your claim is rejected, you can file a complaint through the Krishi Rakshak Portal, the insurance company’s grievance redressal cell, or your local agricultural office."
          }
        ],
        "pmfby.kharif": [
          {
            "answer": "Kharif season refers to the monsoon cropping season, typically from June to October. Crops grown in this season include paddy (rice), maize, soybean, cotton, groundnut, and bajra."
          }
        ],
        "pmfby.rabi": [
          {
            "answer": "Rabi season refers to the winter cropping season, typically from November to April. Common Rabi crops include wheat, barley, mustard, chickpeas, and peas."
          }
        ],
        "pmfby.notifiedCrops": [
          {
            "answer": "Notified crops under PMFBY are those crops identified by the state government for insurance coverage in a particular region and season. These crops are selected based on their economic importance and vulnerability to risks like natural calamities."
          }
        ],
        "pmfby.krph": [
          {
            "answer": "KRPH (Krishi Rakshak Portal Helpline) is an online platform designed to assist farmers in raising grievances, tracking claims, and getting updates on their PMFBY applications."
          }
        ],
        "pmfby.faq1": [
          {
            "answer": "Pradhan Mantri Fasal Bima Yojana (PMFBY) is a Government Scheme that aims at providing crop insurance protection to farmers, when notified crops are damaged due to unexpected natural calamities like hailstorm, drought, floods, cyclones, heavy and unseasonal rains, attack of disease and pests etc."
          }
        ],
        "pmfby.faq2": [
          {
            "answer": "The PMFBY scheme was launched on 18th February 2016, by the honorable Prime Minister of India."
          }
        ],
        "pmfby.faq4": [
          {
            "answer": "All farmers, including tenant farmers and sharecroppers cultivating notified crops in notified areas are eligible for crop insurance."
          }
        ],
        "pmfby.faq5": [
          {
            "answer": "Individual farmers not cultivating the notified crops and farmer groups/collectives are not eligible for the benefits under the scheme. "
          }
        ],
        "pmfby.faq6": [
          {
            "answer": "Crop insurance is a crucial tool that helps farmers safeguard themselves from financial losses caused by unexpected natural disasters such as hailstorms, droughts, floods, cyclones, heavy rains, diseases, and pests. It provides a safety net for farmers in case of such unforeseen events."
          }
        ],
        "pmfby.faq7": [
          {
            "answer": "Adverse weather/climatic conditions such as heavy rains, floods, hailstones, cloudbursts, landslide and natural fire etc, can cause significant damage to crops, partially or wholly. It can burden you economically and socially. Therefore, it is imperative to have economic and social security with the help of crop insurance so that you are protected from probable crop loss."
          }
        ],
        "pmfby.faq8": [
          {
            "answer": "Pradhan Mantri Fasal Bima Yojana (PMFBY) provides crop insurance protection to farmers in case of damage to notified crops due to unexpected natural calamities. Notified crops are those identified by State Governments to be covered under crop insurance. Field crops like cereals, pulses, and oilseeds are covered under PMFBY, while horticulture crops such as fruits and vegetables are covered under the Restructured Weather Based Crop Insurance Scheme (RWBCIS). The scheme offers farmers very low premium rates to participate in the insurance scheme."
          }
        ],
        "pmfby.faq9": [
          {
            "answer": "You can call on toll-free Krishi Rakshak helpline no 14447 or reach out to the nearest Bank Branch/Banking Correspondent, Primary Agriculture Credit Societies (PACS), Common Service Centre (CSC), representative of the insurance company in your area, or the local agriculture office at District/Block level for information and insurance of notified crops. For more details, you can also visit the National Crop Insurance Portal at www.pmfby.gov.in."
          }
        ],
        "pmfby.faq10": [
          {
            "answer": "All farmers, including tenant farmers and sharecroppers cultivating notified crops in notified areas, are eligible for crop insurance. The enrollment has been made voluntary for all farmers, so now farmers can join the scheme as per their willingness."
          }
        ],
        "pmfby.faq11": [
          {
            "answer": "Crops notified by the State Govt in its notification are covered under crops insurance scheme. the State Govt releases this notification at beginning of every season. The scheme includes all food grain, oilseed crops, and annual commercial/annual horticulture crops in both Kharif and Rabi seasons."
          }
        ],
        "pmfby.faq12": [
          {
            "answer": "The premium rates for enrolment under PMFBY are 2% for Kharif crop, 1.5% for Rabi crops, and up to 5% for horticulture and commercial crops of the sum insured."
          }
        ],
        "pmfby.faq13": [
          {
            "answer": "Common Service Centers (CSC) are local access facilities that serve rural and remote locations, providing various government e-services including enrollment for schemes like PMFBY/RWBCIS. You can also enrol through the nearest bank branch, primary agriculture cooperative societies, post office, insurance intermediary, or self-enrollment via the web portal-https://www.pmfby.gov.in/farmerLogin. "
          }
        ],
        "pmfby.faq14": [
          {
            "answer": "Non-loanee farmers can enroll by contacting the nearest Common Service Centre (CSC), banks, or insurance intermediaries. Loanee farmers can approach the bank branches from where they have availed the seasonal agriculture loan/KCC. Farmers with savings or Jan Dhan accounts can also enroll at their bank branches. Online registration through the PMFBY web portal is another option. Intermediaries of insurance companies can also assist in enrollment throug the Intermediary Enrolment (AIDE) App."
          }
        ],
        "pmfby.faq15": [
          {
            "answer": "Thats correct! All Savings or Jan Dhan Account holding farmers can enroll in the scheme through their respective bank branches."
          }
        ],
        "pmfby.faq16": [
          {
            "answer": "Banks play a crucial role in enrolling Loanee farmers under PMFBY/RWBCIS by ensuring the enrolment of Loanee and other interested farmers, maintaining proper records, encouraging farmers to join the scheme, and timely data entry on the PMFBY portal. It is important for banks to coordinate effectively to avoid duplication and provide necessary support to the farmers."
          }
        ],
        "pmfby.faq17": [
          {
            "answer": "No, there are no changes made by the Central Government or State Government.Keep yourself updated with the latest information."
          }
        ],
        "pmfby.faq18": [
          {
            "answer": "To submit a self-declaration to the bank as an existing loanee farmer who does not wish to be enrolled under the scheme, you can do so by providing a written statement to your serving bank branch, at least 7 days before the cut-off date for enrolment for the respective season. If you do not submit this self-declaration, the premium amount for the notified crops will be deducted from your account by the bank."
          }
        ],
        "pmfby.faq19": [
          {
            "answer": "General enrolment cut-offs for Kharif season is 15-31 July and for Rabi season it is 15-30 December. it may vary from state to state depending on crop cultivation cycle."
          }
        ],
        "pmfby.faq20": [
          {
            "answer": "To enrol in the crop insurance scheme, you will need to provide certain mandatory documents. These include your Land Rights Documents such as Record of Right (RoR) and Land Possession Certificate (LPC), an updated Aadhar Card, and your Bank Passbook (First Page with details of bank accounts)."
          }
        ],
        "pmfby.faq21": [
          {
            "answer": "Along with Mandatory documents the Satte Govt May also specify requirement of Supporting Alternative Documents like:\n• Sowing Certificate (Patwari or Gram Panchayat) or other documents by the State Government.\n• Self-Declaration of the intent to sow the proposed crop or sown crop\n\nPlease let me know if you have more questions on the supportive documents required."
          }
        ],
        "pmfby.faq22": [
          {
            "answer": "Along with Mandatory document, tenant farmer also required to sumit following supportive documents  : \n Contract Agreement in case of lease deed and shared crop / No objection certificate issue by land owner.  \n\nPlease let me know if you have more questions on supportive documents required for tenant farmers."
          }
        ],
        "pmfby.faq23": [
          {
            "answer": "Enrolment under PMFBY is absolutely free of charge. Farmers only need to pay their share of the premium amount."
          }
        ],
        "pmfby.faq24": [
          {
            "answer": "Under the revamped scheme, farmers can now voluntarily enroll in the Revamped PMFBY/RWBCIS. Loanee farmers who do not wish to be part of the scheme can choose to Opt Out by submitting a self-declaration to their bank branch. Additionally, all Savings or Jan Dhan Account holding farmers are eligible to participate by enrolling through their respective bank branches. Its important for farmers to inform the bank branches if they wish to participate in the scheme while renewing or applying for a Kisan Credit Card. Farmers also have the flexibility to change the insured crop name up to 2 working days before the cut-off date for enrollment. The premium rates for the scheme remain the same as before."
          }
        ],
        "pmfby.faq25": [
          {
            "answer": "All the proposed changes are effective from kharif 2020 season.Remember, these changes are aimed at improving the effectiveness of the scheme for farmers across the country."
          }
        ],
        "pmfby.faq26": [
          {
            "answer": "The sum insured will be calculated based on various options provided to State Governments, such as Scale of Finance determined by District Level Technical Committee, District level value of Notional Average Yield x Minimum Support Price for any district-crop combination, Farmgate price for crops without MSP, and weighted average market price for the previous season. Each district may choose the most suitable method for their specific crop combinations."
          }
        ],
        "pmfby.faq27": [
          {
            "answer": "Prevented Sowing, Mid – Season Adversity, Localized Calamity, Post – Harvest Loss and Widespread Calamity are the risks covered under PMFBY/RWBCIS."
          }
        ],
        "pmfby.faq28": [
          {
            "answer": "Prevented sowing refers to the situation where more than 75% of the crop in the normal sowing area is affected due to adverse seasonal or weather conditions, leading to the inability to sow, plant, or germinate the crops. In such cases, a claim payment of 25% of the sum assured can be made, subject to the State Government issuing a notification regarding this situation."
          }
        ],
        "pmfby.faq29": [
          {
            "answer": "Mid-season adversity refers to various challenges that can affect crop production during the growing period, such as drought, floods, pests, diseases, and natural disasters like storms and cyclones. The government provides risk protection against these adversities to support farmers in case their crop production is significantly reduced. The compensation amount is determined based on the extent of the losses incurred by the farmers."
          }
        ],
        "pmfby.faq30": [
          {
            "answer": "Localized calamity refers to risks such as hailstorm, landslide, inundation, cloud burst, and natural fire due to lightning that affect isolated farms in a specific area. When such events occur, a joint survey is conducted by the State Government and Insurance Company to assess the crop loss on an individual farm basis. If a farmer is insured and experiences crop loss due to a localized calamity, they should inform the relevant authorities within 72 hours of the incident, providing details of the insured crop and affected area."
          }
        ],
        "pmfby.faq31": [
          {
            "answer": "Post-Harvest Losses refer to the yield loss of crops that are harvested and left in the field for drying for up to 2 weeks after harvesting. This loss is assessed against specific risks like Hailstorm, Cyclone, Cyclonic rains, and Unseasonal rains. If there is a crop loss, the insured farmer should inform the relevant authorities within 72 hours, providing details of the insured crop and affected area. The assessment of loss is done on an individual farm basis."
          }
        ],
        "pmfby.faq32": [
          {
            "answer": "Yes, you will receive an acknowledgement receipt with a unique identification number upon successful submission of your application at the CSC centre. Additionally, insurance companies send acknowledgement receipts to loanee farmers through the post office. You will also receive information through SMS on the registered mobile number."
          }
        ],
        "pmfby.faq33": [
          {
            "answer": "After logging into the PMFBY Portal at www.pmfby.gov.in, you can easily track your application status by clicking on the tab \"Application Status\". Simply enter your application number and captcha, then click to check the status. A new window will display the current status of your application."
          }
        ],
        "pmfby.faq34": [
          {
            "answer": "Crop Insurance App is an android based app developed by the Ministry of Agriculture and Farmers Welfare, Government of India for facilitating Crop Loss Intimation during Localized Calamities and Post-Harvest Losses. Farmers can also download this app from Google Play Store here: https://play.google.com/store/apps/details?id=in.farmguide.farmerapp.central&pcampaignid=web_share"
          }
        ],
        "pmfby.faq35": [
          {
            "answer": "Dear beneficThis app provides a comprehensive set of crop insurance services. Farmers can easily download their crop insurance policy, check premium details, report crop losses, and even upload pictures and videos for crop damage assessment."
          }
        ],
        "pmfby.faq36": [
          {
            "answer": "You can find detailed information about the implementing Insurance Company by contacting on toll free krishi Rakshak helpline no 14447 at CSCs, Bank Branches, or by contacting District or Block Level Agriculture Officers. To know which insurance company is operating in your area for this season, you can reach out to the District or Block Level Agriculture Officers. Another way is to check the PMFBY portal https://pmfby.gov.in/  and use the Insurance Premium Calculator on the home page."
          }
        ],
        "pmfby.faq37": [
          {
            "answer": "The Insurance Unit is basically a defined area by the State Government for the implementation of the Scheme. It could be a Village, Village Panchayat, Revenue Circle, Patwar Halka, District, Taluka, or any other equivalent administrative unit."
          }
        ],
        "pmfby.faq38": [
          {
            "answer": "If you have not submitted an Opt out declaration to your serving bank branch at least 7 days before the enrollment cutoff date, then the premium will be directly deducted from your loan account."
          }
        ],
        "pmfby.faq39": [
          {
            "answer": "The enrolment under PMFBY/RWBICS is completely free for farmers. CSCs/VLEs should not charge any additional amount from farmers other than the premium. If they do, legal or administrative action may be taken against them."
          }
        ],
        "pmfby.faq40": [
          {
            "answer": "In the event of natural calamities like Localized Calamities or Post-Harvest Losses, you should reach out to the concerned Insurance Company, Bank, PACS/CSC, Block and District officers, State Officer of the local agriculture department, or call at Centralized KRPH Toll Free Number 14447 within 72 hours of the occurrence. You can also directly lodge your crop loss intimation through the Crop Insurance App https://play.google.com/store/apps/details?id=in.farmguide.farmerapp.central&pcampaignid=web_share ."
          }
        ],
        "pmfby.faq41": [
          {
            "answer": "The process for informing incidents of crop losses and obtaining Insurance Claims involves reporting the loss within 72 hours to the 1) Insurance Company, Bank, or State Government Officers. 2) Intimate via crop insurace mobile app or 3) call on toll free Krishi rakshak Helpline no 14447 .The information is then forwarded to the insurance company for assessment, and the claim payment is made to eligible farmers within 15 days. If you have any further questions, feel free to ask."
          }
        ],
        "pmfby.faq42": [
          {
            "answer": "Insurance Companies are generally expected to settle the claims within 21 days of receiving final actual yield data from the State Govt, as long as the State share of subsidy is released. State Govts should ideally provide final actual yield data within one month of the crop being harvested."
          }
        ],
        "pmfby.faq43": [
          {
            "answer": "If you are facing any delays in claim settlement, you can report your complaint through the Krishi Rakshak Helpline and Portal (KRPH). You can call the centralized toll-free number 14447 for assistance with any issues related to PMFBY/RWBCS implementation."
          }
        ],
        "pmfby.faq44": [
          {
            "answer": "The grievance redressal mechanism under PMFBY/RWBCIS involves different levels of committees to address farmers concerns. At the primary level, the District Agriculture Officer responds to grievances within 7 days. If there is dissatisfaction, the matter can be escalated to the District Level Grievance Redressal Committee (DGRC). This committee, headed by the District Magistrate/Collector, includes representatives from Banks, NABARD, Insurance Company, concerned State Authority and farmers. If needed, grievances can be further escalated to the State Level Grievance Redressal Committee (SGRC) within 15 days. The SGRC, led by the Principal Secretary/Secretary of the Nodal Department, aims to resolve matters within 15 days. Its important that all parties accept the decision made by the committee."
          }
        ],
        "pmfby.faq45": [
          {
            "answer": "When applying for PMFBY/RWBCIS, it is important for farmers to ensure they share accurate crop details and area during enrollment. Any discrepancies in this information could lead to the rejection of the application by the Insurance Company during the approval process. Additionally, providing correct bank details is crucial as the claim amount is directly transferred to the farmers account under the Direct Benefit Transfer (DBT) policy of the Government of India. It is+ also essential to remember that incorrect information could result in claim payment denial, especially during loss assessment for localized calamities or post-harvest losses. In the event of a localized calamity or post-harvest losses, farmers must promptly inform the concerned bank, insurance company, or local agriculture department within 72 hours. Stay informed and ensure all details are accurate to benefit fully from the PMFBY/RWBCIS schemes."
          }
        ],
        "pmfby.faq46": [
          {
            "answer": "Under the revamped PMFBY, Insurance Companies are now allotted business for three years. This means that farmers will receive crop insurance service from the same insurance company for three consecutive years. This change eliminates the need for farmers to visit different insurance companies every season in case of crop losses. Additionally, Insurance Companies are required to provide a fully functional toll-free number for farmers to access relevant information. Moreover, Insurance Companies must establish offices at district and block levels and deploy skilled manpower to assist farmers effectively."
          }
        ],
        "pmfby.faq47": [
          {
            "answer": "To ensure that farmers receive timely claim payments, the government has introduced various technological solutions like YES-TECH and WINDS initiatives, DIGI-Claim module, and the mandatory use of Crop Cutting Experiments (CCE) Agri App for real-time capturing of CCEs. These initiatives aim to streamline the estimation of crop losses and claim computation processes."
          }
        ]
      }
    }
